# APENAS PARA EXEMPLO DE FORMATACAO - nao usar estes valores em producao.

# DATABASE_URL e a unica credencial de banco lida em runtime (api.main e api.worker_main).
# Aceita postgres://, postgresql://, postgresql+psycopg:// e postgresql+asyncpg:// na
# entrada; o engine sempre normaliza para postgresql+psycopg:// antes de conectar.
# Local (Postgres 17 via `supabase start`):
DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:54322/postgres
# Hosted: login dedicado de runtime (dmitri_runtime), Supabase Transaction pooler 6543.
# DATABASE_URL=postgresql+psycopg://dmitri_runtime.<project-ref>:[SENHA-URL-ENCODED]@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require

# DATABASE_URL_DIRECT NAO e um campo de Settings e NAO deve entrar neste arquivo nem em
# variavel do Railway: e lida apenas por `alembic/env.py` direto de os.environ. Exporte-a
# temporariamente no shell so para rodar `alembic upgrade head` / `alembic downgrade`, e
# depois faca `unset DATABASE_URL_DIRECT`. Aceita os mesmos quatro prefixos Postgres.
# Local:  export DATABASE_URL_DIRECT=postgresql+psycopg://postgres:postgres@127.0.0.1:54322/postgres
# Hosted (credencial administrativa `postgres`, Session pooler 5432 se a rede for
# IPv4-only, pois a conexao direta e IPv6-only):
#   export DATABASE_URL_DIRECT=postgresql+psycopg://postgres.<project-ref>:[SENHA]@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require

ENRICHMENT_POLL_INTERVAL_SECONDS=5
ENRICHMENT_BATCH_SIZE=10
KEV_API_BASE_URL=https://www.cisa.gov/sites/default/files/feeds/known_exploited_vulnerabilities.json
KEV_CACHE_TTL_HOURS=24
EPSS_API_BASE_URL=https://api.first.org/data/v1/epss
EPSS_CACHE_TTL_HOURS=24
NVD_API_BASE_URL=https://services.nvd.nist.gov/rest/json/cves/2.0
NVD_API_KEY=
NVD_CACHE_TTL_HOURS=12
