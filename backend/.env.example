# APENAS PARA EXEMPLO DE FORMATAÇÃO

# Backend
POSTGRES_USER=postgres
POSTGRES_PASSWORD=supersecretpassword # pragma: allowlist secret
POSTGRES_DB=scanner_dev
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}
BACKEND_HOST_PORT=18000

# --- Supabase (staging/prod) ---
# Do dashboard (botao "Connect"), copie AS DUAS strings. Troque PROJECT_REF e a senha.
# Voce usa as duas ao mesmo tempo (nao e uma OU outra):
#   DATABASE_URL           -> app rodando  (Transaction pooler, 6543)
#   MIGRATION_DATABASE_URL -> migrations   (Session pooler, 5432)
# Deixe comentadas aqui; ative no seu .env real.
# NOTA: use o Session pooler (host ...pooler.supabase.com, user postgres.PROJECT_REF)
#   para migrations, NAO a Direct connection (db.PROJECT_REF.supabase.co). A direct e
#   IPv6-only sem add-on pago; redes/CI IPv4-only nao resolvem o host. O session pooler
#   e IPv4 e tambem suporta DDL. (username muda: postgres.PROJECT_REF, nao postgres)
# DATABASE_URL=postgresql+asyncpg://postgres.PROJECT_REF:[YOUR-PASSWORD]@aws-0-us-east-1.pooler.supabase.com:6543/postgres
# MIGRATION_DATABASE_URL=postgresql+psycopg://postgres.PROJECT_REF:[YOUR-PASSWORD]@aws-0-us-east-1.pooler.supabase.com:5432/postgres
ENRICHMENT_POLL_INTERVAL_SECONDS=5
ENRICHMENT_BATCH_SIZE=10
KEV_API_BASE_URL=https://www.cisa.gov/sites/default/files/feeds/known_exploited_vulnerabilities.json
KEV_CACHE_TTL_HOURS=24
EPSS_API_BASE_URL=https://api.first.org/data/v1/epss
EPSS_CACHE_TTL_HOURS=24
NVD_API_BASE_URL=https://services.nvd.nist.gov/rest/json/cves/2.0
NVD_API_KEY=
NVD_CACHE_TTL_HOURS=12

# JWT
JWT_SECRET=super-secret-key-change-in-production # pragma: allowlist secret
JWT_ACCESS_EXPIRE_MINUTES=60
JWT_REFRESH_EXPIRE_DAYS=7

# Security
HMAC_SECRET=another-secret-for-pi-agent # pragma: allowlist secret
