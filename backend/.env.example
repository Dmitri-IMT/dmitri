DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:54322/postgres
# DATABASE_URL=postgresql+psycopg://dmitri_runtime.<project-ref>:<URL-ENCODED-PASSWORD>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require
# Optional AI interpretation. Provider credentials are added only with the provider.
AI_ENABLED=false
AI_PROVIDER=groq
AI_MODEL=openai/gpt-oss-120b
AI_API_KEY=
AI_API_BASE_URL=https://api.groq.com/openai/v1
AI_MAX_FINDINGS=10
AI_TIMEOUT_SECONDS=30
AI_MAX_OUTPUT_TOKENS=4096
AI_REASONING_EFFORT=low
AI_MAX_ATTEMPTS=2
AI_RETRY_DELAY_SECONDS=30
ENRICHMENT_POLL_INTERVAL_SECONDS=5
ENRICHMENT_BATCH_SIZE=10
KEV_API_BASE_URL=https://www.cisa.gov/sites/default/files/feeds/known_exploited_vulnerabilities.json
KEV_CACHE_TTL_HOURS=24
EPSS_API_BASE_URL=https://api.first.org/data/v1/epss
EPSS_CACHE_TTL_HOURS=24
NVD_API_BASE_URL=https://services.nvd.nist.gov/rest/json/cves/2.0
NVD_API_KEY=
NVD_CACHE_TTL_HOURS=12
JWT_SIGNING_SECRET=
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
REFRESH_COOKIE_SECURE=true
# CORS fails closed when empty. Set a comma-separated browser-origin allowlist per deployment.
# Local development example: CORS_ALLOWED_ORIGINS=http://localhost:5173
CORS_ALLOWED_ORIGINS=
RESET_TOKEN_TTL_MINUTES=60
HIBP_ENABLED=true
HIBP_TIMEOUT_SECONDS=2
DEVICE_SIG_MAX_SKEW_SECONDS=300
INVITE_TTL_HOURS=48
# Transactional email (Resend). Unset RESEND_API_KEY disables sending: invites
# and resets still work, the link is just not emailed.
RESEND_API_KEY=
RESEND_API_BASE_URL=https://api.resend.com/emails
MAIL_FROM=Dmitri <no-reply@mail.peirce.dev>
MAIL_REPLY_TO=support@peirce.dev
MAIL_TIMEOUT_SECONDS=10
# APP_BASE_URL is the frontend origin the invite and reset links point at:
# http://localhost:5173 locally, https://dmitri.peirce.dev deployed.
APP_BASE_URL=http://localhost:5173
