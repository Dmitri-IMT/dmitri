# APENAS PARA EXEMPLO DE FORMATAÇÃO

# Backend
POSTGRES_USER=postgres
POSTGRES_PASSWORD=supersecretpassword # pragma: allowlist secret
POSTGRES_DB=scanner_dev
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}
BACKEND_HOST_PORT=18000
SUPABASE_URL=  # apenas em staging/prod
SUPABASE_KEY=  # apenas em staging/prod
ENRICHMENT_POLL_INTERVAL_SECONDS=5
ENRICHMENT_BATCH_SIZE=10
KEV_API_BASE_URL=https://www.cisa.gov/sites/default/files/feeds/known_exploited_vulnerabilities.json
KEV_CACHE_TTL_HOURS=24
EPSS_API_BASE_URL=https://api.first.org/data/v1/epss
EPSS_CACHE_TTL_HOURS=24
NVD_API_BASE_URL=https://services.nvd.nist.gov/rest/json/cves/2.0
NVD_API_KEY=
NVD_CACHE_TTL_HOURS=12

# JWT
JWT_SECRET=super-secret-key-change-in-production # pragma: allowlist secret
JWT_ACCESS_EXPIRE_MINUTES=60
JWT_REFRESH_EXPIRE_DAYS=7

# Security
HMAC_SECRET=another-secret-for-pi-agent # pragma: allowlist secret
