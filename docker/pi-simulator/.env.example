DATABASE_URL=postgresql+psycopg://postgres:postgres@db:5432/dmitri_sim
JWT_SIGNING_SECRET=simulator-local-jwt-signing-secret
# Unauthenticated NVD allows ~5 requests/30s; with a key ~50. Paste your own.
NVD_API_KEY=
# Invite acceptance otherwise calls Have I Been Pwned over the network, which fails
# offline and rejects a fixed dev password.
HIBP_ENABLED=false
# The simulator is plain HTTP.
REFRESH_COOKIE_SECURE=false
# CORS fails closed when unset; this is the Vite dev server.
CORS_ALLOWED_ORIGINS=http://localhost:5173
SIM_ADMIN_EMAIL=dev@example.invalid
# Not a secret, and not to be "fixed" into one. A password is genuinely required —
# require_admin -> require_user -> bearer JWT, and only POST /api/v1/auth/login mints
# that token. The account is local-only, in an org named sim, in a throwaway database
# on a local bridge, with no relationship to any real account. compose.nspi.yaml carries
# no seeding, so it can never reach a deployed environment. Minimum 12 characters, and
# it must not contain the org name (sim) or any part of SIM_ADMIN_EMAIL
# (api/services/passwords.py).
SIM_ADMIN_PASSWORD=Quiet-Harbour-Lantern
