# Copy to .env on the Linux VM. Reserve all target addresses outside DHCP.
# Example only: change to match the VM/Raspberry LAN before starting Compose.
LAB_PARENT_INTERFACE=ens33
LAB_SUBNET=192.168.50.0/24
LAB_GATEWAY=192.168.50.1
LAB_WEB_IP=192.168.50.33
LAB_SSH_IP=192.168.50.34
LAB_FTP_IP=192.168.50.35
LAB_SMB_IP=192.168.50.36
LAB_TELNET_IP=192.168.50.37
LAB_MYSQL_IP=192.168.50.38
LAB_MYSQL_ROOT_PASSWORD=replace-with-fake-lab-only-root-password
LAB_MYSQL_PASSWORD=replace-with-fake-lab-only-password
