{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ScanResult",
  "type": "object",
  "description": "Top-level payload transmitted from the hardware agent to the backend.",
  "required": ["scan_id", "timestamp", "subnet", "target_mode", "scan_profile", "devices", "findings"],
  "properties": {
    "scan_id": {
      "type": "string",
      "description": "Unique identifier for the scan (UUID v4 recommended)",
      "pattern": "^[0-9a-fA-F-]{8,}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp when the scan completed"
    },
    "subnet": {
      "type": "string",
      "description": "CIDR range that was scanned",
      "pattern": "^([0-9]{1,3}[.]){3}[0-9]{1,3}/[0-9]{1,2}$"
    },
    "target_mode": {
      "type": "string",
      "enum": ["single_host", "subnet", "multi_host"],
      "description": "Describes how the target was interpreted by the agent"
    },
    "scan_profile": {
      "type": "string",
      "enum": ["single-host", "lab", "lan", "deep"],
      "description": "Named scan profile executed by the agent"
    },
    "devices": {
      "type": "array",
      "items": { "$ref": "device.schema.json" },
      "minItems": 0,
      "description": "List of devices observed during the scan"
    },
    "findings": {
      "type": "array",
      "description": "Findings derived from the scan, either global or device-specific references",
      "items": { "$ref": "finding.schema.json" },
      "minItems": 0,
      "default": []
    },
    "artifacts": {
      "type": "array",
      "description": "Optional references to raw artifacts generated during scanning",
      "items": {
        "type": "object",
        "required": ["kind", "path", "stage"],
        "properties": {
          "kind": {
            "type": "string",
            "enum": ["nmap_xml", "nse_output"]
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "stage": {
            "type": "string",
            "minLength": 1
          },
          "host_ip": {
            "type": ["string", "null"],
            "format": "ipv4"
          }
        },
        "additionalProperties": false
      },
      "minItems": 0,
      "default": []
    },
    "metadata": {
      "type": "object",
      "description": "Optional bag for agent version, runtime info, and counters",
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
