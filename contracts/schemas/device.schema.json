{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Device",
  "type": "object",
  "description": "Normalized representation of a host detected during scanning.",
  "required": ["ip", "mac", "hostname", "vendor", "ports"],
  "properties": {
    "ip": {
      "type": "string",
      "format": "ipv4",
      "description": "IPv4 address assigned to the device"
    },
    "mac": {
      "type": ["string", "null"],
      "pattern": "^([0-9A-Fa-f]{2}:){5}[0-9A-Fa-f]{2}$",
      "description": "MAC address derived from ARP/Nmap results"
    },
    "hostname": {
      "type": "string",
      "description": "Best-effort hostname collected during discovery"
    },
    "vendor": {
      "type": "string",
      "description": "Vendor/manufacturer inferred from the MAC prefix or banner"
    },
    "ports": {
      "type": "array",
      "description": "Open or filtered ports observed during the scan",
      "items": { "$ref": "#/$defs/port" },
      "minItems": 0
    }
  },
  "$defs": {
    "port": {
      "type": "object",
      "required": ["port", "protocol", "state", "service"],
      "properties": {
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535,
          "description": "Network port number"
        },
        "protocol": {
          "type": "string",
          "enum": ["tcp", "udp"],
          "description": "Layer 4 protocol used by the service"
        },
        "state": {
          "type": "string",
          "enum": ["open", "closed", "filtered"],
          "description": "State reported by Nmap"
        },
        "service": {
          "type": "string",
          "description": "Service name inferred from Nmap signatures"
        },
        "version": {
          "type": ["string", "null"],
          "description": "Optional product/version banner when detected"
        },
        "cpes": {
          "type": "array",
          "description": "Explicit CPE identifiers derived from service detection",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0,
          "default": []
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
