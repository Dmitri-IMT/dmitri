#!/bin/sh
# Skip the upgrade while a scan runs. An upgrade restarts dmitri-agent and
# drops the in-process scan ledger. Every scan holds a shared lock on this
# file (agent/scanner/scan_lock.py) until it ends.
set -eu
lock=/var/lib/dmitri/dmitri/scan.lock
mkdir -p "$(dirname "$lock")"
exec 9>>"$lock"
if ! flock -n -x 9; then
    echo "hardware-agent: scan in progress, not upgrading"
    exit 0
fi
apt-get update
apt-get install -y --only-upgrade hardware-agent
