[Unit]
Description=Dmitri durable update supervisor
After=local-fs.target
Before=dmitri-agent.service
Wants=network-online.target

[Service]
Type=notify
NotifyAccess=main
ExecStart=/usr/bin/python3 /usr/lib/dmitri/updater.py
Restart=on-failure
RestartSec=2s
KillMode=control-group
TimeoutStartSec=30s
RuntimeDirectory=dmitri-agent-updater
RuntimeDirectoryMode=0700
StateDirectory=dmitri/updates
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=true
ProtectHome=true
ProtectSystem=full
ReadWritePaths=/var/lib/dmitri /run/dmitri-agent-updater /var/lib/apt/lists /var/lib/apt/lists/partial /var/lib/dpkg /var/cache/apt /etc /usr/lib/systemd/system /lib/systemd/system /opt/dmitri-agent
StandardOutput=journal
StandardError=journal
