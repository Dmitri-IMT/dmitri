AGENT_BACKEND_BASE_URL=http://127.0.0.1:8000/api/v1
AGENT_SUBMIT_RESULTS=false
# Optional. If omitted, the agent auto-detects the active IPv4 subnet.
# AGENT_SCAN_SUBNET=192.168.15.0/24
AGENT_SCAN_MODE=quick
AGENT_NMAP_SCRIPTS=vulners,smb2-security-mode,smb-protocols,ssh-auth-methods,ssh2-enum-algos,http-title,http-server-header,http-methods,ssl-cert
AGENT_MIN_CVSS=5.0
AGENT_MAX_WORKERS=4
AGENT_HOST_BATCH_SIZE=8
AGENT_OUTPUT_PATH=/app/artifacts/lab-scan.json
