AGENT_BACKEND_BASE_URL=http://127.0.0.1:8000/api/v1
AGENT_SUBMIT_RESULTS=false
# Optional. Use one of these:
# AGENT_SCAN_TARGET=192.168.15.10
# AGENT_SCAN_TARGET=192.168.15.10,192.168.15.20
# AGENT_TARGET_MODE=single_host
# Optional. If omitted, the agent auto-detects the active IPv4 subnet.
# AGENT_SCAN_SUBNET=192.168.15.0/24
AGENT_SCAN_PROFILE=lan
AGENT_VULNERS_SCRIPT=vulners
AGENT_MIN_CVSS=5.0
AGENT_MAX_WORKERS=4
AGENT_HOST_BATCH_SIZE=8
AGENT_OUTPUT_PATH=/app/artifacts/lab-scan.json
AGENT_SAVE_RAW_ARTIFACTS=false
AGENT_RAW_ARTIFACTS_DIR=/app/artifacts/raw
